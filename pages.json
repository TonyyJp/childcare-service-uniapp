{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "智优托教",
        "navigationStyle": "custom",
        "backgroundColor": "#FFF8F2"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-teacher",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom",
            "backgroundColor": "#FFF8F2"
          }
        }
      ]
    },
    {
      "root": "pages-parent",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom",
            "backgroundColor": "#EFF7FF"
          }
        }
      ]
    },
    {
      "root": "pages-institution",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom",
            "backgroundColor": "#F9F5FF"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages-teacher", "pages-parent", "pages-institution"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智优托教",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F5F5",
    "app-plus": {
      "background": "#efeff4"
